FLASK_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/be_rao
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
FLASK_DEBUG=0

# --- SolarWeb (served at /solar by wsgi.py) ---
# SolarWeb reads SOLARWEB_<NAME> first, then <NAME>. DATABASE_URL is shared (its tables are prefixed sw_).
# If SOLARWEB_SECRET_KEY is blank, one is derived from SECRET_KEY.
SOLARWEB_SECRET_KEY=
SOLARWEB_ADMIN_USERNAME=admin
# Blank = a password is generated and printed on first start (must be changed at first login)
SOLARWEB_ADMIN_PASSWORD=
# Public base URL including the /solar prefix, used for canonical links and the sitemap
SOLARWEB_SITE_URL=
# 1 = tell search engines not to index (keep on while testing at /solar)
SOLARWEB_NOINDEX=1
SOLARWEB_ADMIN_EMAIL=
SOLARWEB_SMTP_HOST=
SOLARWEB_SMTP_PORT=587
SOLARWEB_SMTP_USER=
SOLARWEB_SMTP_PASSWORD=
SOLARWEB_SMTP_FROM=
SOLARWEB_TURNSTILE_SITE_KEY=
SOLARWEB_TURNSTILE_SECRET=
SOLARWEB_BEHIND_CLOUDFLARE=0
